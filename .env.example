# Todas las variables tienen un default pensado para desarrollo local, así que
# el server arranca con `npm run dev` sin .env — pero a diferencia de la vieja
# mongodb-memory-server, SÍ hace falta un MySQL corriendo (local o remoto).

# Puerto HTTP del server
PORT=3001

# --- Conexión a MySQL ---
# Host del servidor MySQL.
DB_HOST=127.0.0.1
# Puerto de MySQL.
DB_PORT=3306
# Usuario.
DB_USER=root
# Password (vacío = sin password, típico en un MySQL local recién instalado).
DB_PASSWORD=
# Nombre de la base. Si no existe, el server la crea al arrancar (CREATE
# DATABASE IF NOT EXISTS) y aplica src/db/schema.sql (tablas con IF NOT EXISTS).
# Solo puede tener letras, números y guión bajo.
DB_NAME=tododb

# "development" (default) o "production". Controla, entre otras cosas,
# si las cookies de sesión se emiten con el flag Secure (requiere HTTPS)
# y si el server exige que el secret de JWT esté seteado para arrancar.
NODE_ENV=development

# Secret para firmar el JWT del access token (única cookie de sesión, sin
# refresh token). Si no está seteado, el server arranca igual en dev con
# un secreto hardcodeado inseguro (se loguea un warning bien visible al
# arrancar) — pero en NODE_ENV=production es OBLIGATORIO: si falta, el
# server no arranca.
JWT_ACCESS_SECRET=

# Origin exacto (protocolo+host+puerto) del frontend que va a consumir la
# API con cookies (fetch/axios con credentials:'include'). Sin esta variable
# no se habilita ningún origin por CORS. Ejemplo: http://localhost:5173
CORS_ORIGIN=

# Notas:
# - La duración del token (12hs) está hardcodeada en
#   src/services/authService.js, no es configurable por env var — ver el
#   comentario ahí para el motivo.
# - Si MySQL no está disponible al arrancar, connectDB() falla y el server no
#   levanta (mejor fallar temprano que servir requests rotas).
